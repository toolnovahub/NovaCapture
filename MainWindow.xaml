<Window x:Class="NovaCapture.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NovaCapture" Width="760" Height="620" MinWidth="650" MinHeight="570" Background="#10131B" Foreground="#F5F7FF" WindowStartupLocation="CenterScreen">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#536DFE"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#1E2431"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3A455B"/><Setter Property="Padding" Value="10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
</Window.Resources>
<Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Margin="0,0,0,24"><TextBlock Text="NovaCapture" FontSize="32" FontWeight="Bold"/><TextBlock Text="Screenshot &amp; Screen Recorder · v0.2" Foreground="#A5AFC5" FontSize="14" Margin="0,5,0,0"/></StackPanel>
<Border Grid.Row="1" Background="#1A202D" CornerRadius="14" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="📸  SCREENSHOT" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="Capturează toate monitoarele într-un fișier PNG." Foreground="#ABB6CA" Margin="0,0,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Capturează ecranul" Click="Screenshot_Click"/><Button Content="Deschide folderul" Background="#303A4D" Click="OpenFolder_Click"/></StackPanel></StackPanel></Border>
<Border Grid.Row="2" Background="#1A202D" CornerRadius="14" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="🎬  SCREEN RECORDER" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="Înregistrare MP4 a ecranului principal, fără audio (FFmpeg necesar)." Foreground="#ABB6CA" Margin="0,0,0,16"/><TextBlock Text="CALITATE VIDEO" Foreground="#ABB6CA" FontWeight="SemiBold" Margin="0,0,0,7"/><ComboBox x:Name="QualityCombo" SelectedIndex="1" Height="36" Margin="0,0,0,14" Background="#303A4D" Foreground="#10131B"><ComboBoxItem Content="Standard — nativ, 30 FPS, CRF 23"/><ComboBoxItem Content="Ultra Quality — nativ, 60 FPS, CRF 15"/></ComboBox><StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="● Start recording" Click="Start_Click"/><Button x:Name="StopButton" Content="■ Stop" Background="#B73B53" IsEnabled="False" Click="Stop_Click"/></StackPanel></StackPanel></Border>
<StackPanel Grid.Row="3" Margin="0,4,0,0"><TextBlock Text="FOLDER DE SALVARE" FontWeight="SemiBold" Foreground="#ABB6CA" Margin="0,0,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="Alege folder" Background="#303A4D" Margin="10,0,0,0" Click="ChooseFolder_Click"/><TextBox x:Name="FolderBox" IsReadOnly="True"/></DockPanel><TextBlock Text="FFmpeg: pune ffmpeg.exe în folderul aplicației sau adaugă-l în PATH." Foreground="#8995AC" Margin="0,15,0,0" TextWrapping="Wrap"/></StackPanel>
<Border Grid.Row="4" Background="#202A39" CornerRadius="9" Padding="12" Margin="0,15,0,0"><TextBlock x:Name="StatusText" Text="Pregătit." Foreground="#C4D7FF" TextWrapping="Wrap"/></Border>
</Grid></Window>